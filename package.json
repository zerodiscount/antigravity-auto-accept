{
  "name": "hygient-antigravity-autoaccept",
  "displayName": "Hygient AutoAccept for Antigravity",
  "description": "Automatically accept AI agent actions (file edits, terminal commands, tool executions) in Antigravity IDE while preserving manual Plan reviews",
  "version": "1.0.0",
  "icon": "icon.png",
  "publisher": "Hygient",
  "repository": {
    "type": "git",
    "url": "ssh://git@10.2.100.120:2222/aurametrics/hygient-antigravity-autoaccept.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "auto-accept",
    "antigravity",
    "agent",
    "ai",
    "automation",
    "auto",
    "accept",
    "hygient"
  ],
  "categories": [
    "Machine Learning",
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autoAcceptAgent.toggle",
        "title": "Hygient AutoAccept: Toggle"
      },
      {
        "command": "autoAcceptAgent.start",
        "title": "Hygient AutoAccept: Start"
      },
      {
        "command": "autoAcceptAgent.stop",
        "title": "Hygient AutoAccept: Stop"
      },
      {
        "command": "autoAcceptAgent.acceptNow",
        "title": "Hygient AutoAccept: Accept All Pending Now"
      },
      {
        "command": "autoAcceptAgent.diagnostics",
        "title": "Hygient AutoAccept: Run Diagnostics"
      }
    ],
    "keybindings": [
      {
        "command": "autoAcceptAgent.acceptNow",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+y"
      }
    ],
    "configuration": {
      "title": "Hygient AutoAccept",
      "properties": {
        "autoAcceptAgent.enableCommandPolling": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic polling of accept/approve commands."
        },
        "autoAcceptAgent.pollIntervalMs": {
          "type": "number",
          "default": 800,
          "minimum": 200,
          "maximum": 10000,
          "description": "Interval in milliseconds between polling cycles. Lower = faster auto-acceptance but more CPU. Default: 800ms."
        },
        "autoAcceptAgent.autoConfigureSettings": {
          "type": "boolean",
          "default": true,
          "description": "Automatically configure VS Code/Antigravity settings to skip routine command approval prompts."
        },
        "autoAcceptAgent.interceptNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Automatically accept primary actions on approval notifications (Run, Allow, Yes)."
        },
        "autoAcceptAgent.enableCDP": {
          "type": "boolean",
          "default": false,
          "description": "Enable optional CDP fallback to click approval buttons directly in webviews when command polling cannot reach them. Default: false."
        },
        "autoAcceptAgent.customButtonTexts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional button text labels to auto-click in the agent UI."
        },
        "autoAcceptAgent.blockedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "rm -rf /",
            "format",
            "mkfs",
            "del /f /s /q c:\\",
            "rmdir /s /q c:\\"
          ],
          "description": "Commands that will never be auto-accepted."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ws": "^8.19.0"
  }
}
